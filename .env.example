# ========================================================
# LOUI PORTFOLIO — ENVIRONMENT VARIABLES
# Salin file ini menjadi `.env.local` lalu isi dengan kredensial Anda
# ========================================================

# 1. SUPABASE (Database & Auth)
# Dapatkan di: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Opsional jika menggunakan script / route backend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. CLOUDINARY (Media Storage: Image & Video)
# Dapatkan di: Cloudinary Console Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
# Buat upload preset di: Cloudinary Settings > Upload > Upload Presets (Pilih mode: "Unsigned")
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name

# Opsional untuk backend / server API
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_api_secret

# 3. CLOUDFLARE R2 (Video Object Storage - Zero Egress Fee)
# Dapatkan di: Cloudflare Dashboard > R2 Object Storage > Manage R2 API Tokens
# Account ID dapat dilihat di kanan bawah dashboard Cloudflare atau di URL dashboard R2
R2_ACCOUNT_ID=your_cloudflare_account_id
# R2 API Token (Permissions: Object Read & Write)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Nama bucket yang Anda buat di Cloudflare R2
R2_BUCKET_NAME=justerstore
# Folder di dalam bucket
R2_FOLDER=louiportfolio
# Domain Publik Bucket R2 (cth: https://cdn.justermp.my.id atau https://pub-xxxx.r2.dev)
NEXT_PUBLIC_R2_PUBLIC_URL=https://cdn.justermp.my.id

