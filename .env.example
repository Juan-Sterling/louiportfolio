# ========================================================
# LOUI PORTFOLIO — ENVIRONMENT VARIABLES
# Salin file ini menjadi `.env.local` lalu isi dengan kredensial Anda
# ========================================================

# 1. SUPABASE (Database & Auth)
# Dapatkan di: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Opsional jika menggunakan script / route backend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. CLOUDINARY (Media Storage: Image & Video)
# Dapatkan di: Cloudinary Console Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
# Buat upload preset di: Cloudinary Settings > Upload > Upload Presets (Pilih mode: "Unsigned")
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name

# Opsional untuk backend / server API
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_api_secret
